class Solution {
    public int minTimeToType(String word) {
        int time = 0;
        char current = 'a';

        for (char ch : word.toCharArray()) {
            int distance = Math.abs(ch - current);

            time += Math.min(distance, 26 - distance);

            current = ch;
        }

        return time + word.length();
    }
}
