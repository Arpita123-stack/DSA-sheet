class Solution {
    public int countLargestGroup(int n) {
        int[] count = new int[37];

        // Count numbers for each digit sum
        for (int i = 1; i <= n; i++) {
            int sum = 0;
            int x = i;

            while (x > 0) {
                sum += x % 10;
                x /= 10;
            }

            count[sum]++;
        }

        // Find largest group size
        int max = 0;
        for (int c : count) {
            max = Math.max(max, c);
        }

        // Count groups having largest size
        int ans = 0;
        for (int c : count) {
            if (c == max) {
                ans++;
            }
        }

        return ans;
    }
}
