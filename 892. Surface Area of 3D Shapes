class Solution {
    public int surfaceArea(int[][] grid) {
        int area = 0;
        int n = grid.length;

        for (int i = 0; i < n; i++) {
            for (int j = 0; j < n; j++) {

                if (grid[i][j] > 0) {
                    // Top and bottom
                    area += 2;

                    // Four sides
                    area += 4 * grid[i][j];

                    // Remove shared sides with upper cell
                    if (i > 0) {
                        area -= 2 * Math.min(grid[i][j], grid[i - 1][j]);
                    }

                    // Remove shared sides with left cell
                    if (j > 0) {
                        area -= 2 * Math.min(grid[i][j], grid[i][j - 1]);
                    }
                }
            }
        }

        return area;
    }
}
