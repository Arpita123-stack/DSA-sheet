import java.util.*;

class Solution {
    public List<Boolean> prefixesDivBy5(int[] nums) {
        List<Boolean> result = new ArrayList<>();

        int rem = 0;

        for (int bit : nums) {
            rem = (rem * 2 + bit) % 5;

            if (rem == 0) {
                result.add(true);
            } else {
                result.add(false);
            }
        }

        return result;
    }
}
